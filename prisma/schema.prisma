// Prisma 7: the generator is `prisma-client` (not `prisma-client-js`) and
// `output` is mandatory. Import PrismaClient from the output path, never from
// "@prisma/client".
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7: no `url` here. The connection string lives in /prisma.config.ts,
// and at runtime Neon is reached through the PrismaNeon driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum TaskType {
  TODO
  HABIT
}

enum Priority {
  P1 // now
  P2
  P3
  P4 // default, no flag
}

enum RecurrenceKind {
  DAILY // daysOfWeek = [0..6]
  SPECIFIC_DAYS // user-picked subset
}

enum OccurrenceStatus {
  PENDING
  DONE
  SKIPPED
}

/// POMODORO / BASIC / FLOW are three *shapes a work session can take*.
/// RECOVERY is not a fourth shape — it is the peer of all three, the other
/// half of the cycle. One enum, one model, one log: that is what makes "equal
/// weight" true in the data and not only in the styling.
enum TimerMode {
  POMODORO
  BASIC
  FLOW
  RECOVERY
}

enum SessionStatus {
  RUNNING
  PAUSED
  COMPLETED // ended deliberately, or ran to its natural end
  ABANDONED // never ended cleanly; reaped lazily by the loader
}

enum SessionEndReason {
  TARGET_REACHED
  USER_STOPPED
  TASK_COMPLETED
  ABANDONED
}

enum IntervalKind {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
  /// Deliberately not reusing SHORT_BREAK: a break is a gap *inside* work,
  /// whereas recovery *is* the session. Reusing it would leave every
  /// `kind: FOCUS` query correct and every break-counting query silently wrong.
  RECOVERY
}

enum CaptureStatus {
  RAW // in the inbox, awaiting triage
  PROMOTED // became a Task
  DISMISSED // deliberately let go — kept, because deleting hides the pattern
}

/// What a habit's quota is counted in.
///
/// MINUTES is credited automatically from logged timer sessions, so "meditate
/// for 2 minutes" needs no bookkeeping at all — you just run the timer. COUNT
/// is anything the clock can't see: pages, reps, glasses of water.
enum HabitUnit {
  MINUTES
  COUNT
}

/// Which stretches of the waking day a habit belongs to. Drives visibility,
/// not due-ness: a habit is still due on its days — /day and /calendar just
/// stop offering it outside its windows, so the morning list doesn't carry the
/// evening's plans.
///
/// ALWAYS is a value of its own, not shorthand for all three: the windows cover
/// 5:00–21:00, and an "always" habit stays visible at 23:00 while a habit with
/// all three windows selected does not.
enum HabitSlot {
  MORNING
  AFTERNOON
  EVENING
  ALWAYS
}

/// How far into a day's quota you got.
///
/// Stored on the occurrence rather than recomputed at read time, because the
/// quota itself can change: raising your minimum from 1 page to 10 must not
/// retroactively break a streak you actually earned. Same reasoning as
/// FocusSession snapshotting the user's timer settings.
enum QuotaTier {
  NONE
  MINIMUM
  OPTIMAL
}

enum JournalKind {
  WORRY
  GRATITUDE
}

/// What a block of time on the calendar is *for*. Deliberately short:
/// more kinds would turn planning the day into a taxonomy exercise.
enum BlockKind {
  WORK
  RECOVERY
  /// Deliberately unfilled. The slot you leave empty so the day has give in it
  /// — planning back-to-back is the single most reliable way to plan a day you
  /// then abandon by 11am.
  BUFFER
  /// Imaginary time. Lives on /calendar only — excluded from claimed minutes,
  /// free-slot math, transitions and /day's strip. An output for daydreaming,
  /// not a plan anyone is accountable for.
  DAYDREAM
}

/// Which side of the ledger a category and its transactions sit on.
/// Deliberately not a boolean: INCOME and EXPENSE are different objects with
/// different habits attached, and every read joins on this.
enum MoneyKind {
  INCOME
  EXPENSE
}

/// Which way an IOU points.
/// Deliberately not a boolean: I_OWE and OWED_TO_ME are different lists with
/// different totals, and every read groups on this.
enum DebtDirection {
  I_OWE // money I owe someone
  OWED_TO_ME // money someone owes me
}

/// Whether an exercise needs a mat and nothing else, or a pair of (light)
/// dumbbells. A routine mixes both; the tag drives the generator's balance
/// and the catalog filter.
enum ExerciseEquipment {
  YOGA
  DUMBBELL
}

/// What a routine's week is allowed to draw from: yoga only, dumbbells only,
/// or the mixed catalog. The person's call at build time, stored on the
/// routine so regeneration keeps drawing from the same pool.
enum RoutineEquipment {
  YOGA
  DUMBBELL
  MIX
}

/// The primary corrective job an exercise does. Two postural patterns are
/// being trained: the lower cross (anterior pelvic tilt) and the upper cross
/// (rounded shoulders / forward head). The fix is the same shape in both —
/// stretch the tight front, strengthen the weak back — and each goal is one
/// half of that equation, so the generator can compose a balanced day.
enum ExerciseGoal {
  /// Stretch the tight psoas/quads that pull the pelvis forward (APT).
  HIP_FLEXOR_MOBILITY
  /// Strengthen glutes — the muscle present in every pelvic-correction
  /// strategy, per the EMG literature.
  GLUTE_STRENGTH
  /// Hamstring length + posterior chain, the other half of pelvic neutral.
  HAMSTRING_LENGTH
  /// Deep core, anti-extension: stops the lower back from arching.
  CORE_STABILITY
  /// Release the lower back and keep the spine moving.
  LOWER_BACK_RELIEF
  /// Rhomboids, mid/lower traps, rear delts — pull the shoulders back.
  UPPER_BACK_STRENGTH
  /// Open the tight chest that rounds the shoulders (upper cross).
  CHEST_MOBILITY
  /// Motor control: finding and holding neutral pelvis/spine.
  POSTURE_AWARENESS
  /// Stretch the tight upper traps, levator scapulae and suboccipitals
  /// that pull the head forward (forward head posture).
  NECK_MOBILITY
  /// Deep neck flexors + chin-tuck control: hold the head back over the
  /// spine — the weak half of forward head posture.
  NECK_STRENGTH
  /// Calf/soleus length and ankle mobility — the distal end of the
  /// posterior chain that sitting shortens.
  CALF_MOBILITY
  /// Wrist and forearm flexor/extensor release for typing and phone work.
  WRIST_MOBILITY
  /// Legs working under load: quads, glutes, adductors — the held poses
  /// that burn (Chair, Warrior II, High Lunge).
  LEG_STRENGTH
  /// Upper-body pressing endurance: planks and the Chaturanga family.
  PUSH_STRENGTH
  /// Single-leg and inversion control — wobbling is the work.
  BALANCE
  /// Sustained aerobic work — the one goal the library measures in minutes
  /// rather than reps or holds.
  CARDIO
  /// Deep hip opening: adductors, external rotators, the "hips of a chair"
  /// the deep squat and wide folds reach.
  HIP_MOBILITY
  /// Dorsiflexion and the deep-squat ankle angle that sitting steals.
  ANKLE_MOBILITY
  /// Calf strength — the push-off half of the lower leg, paired with
  /// CALF_MOBILITY's length.
  CALF_STRENGTH
}

/// The muscle groups an exercise works, for filtering the catalog. One
/// exercise may tag several; the primary intent lives in `goal`.
enum BodyPart {
  HIP_FLEXORS
  QUADS
  GLUTES
  HAMSTRINGS
  CORE
  LOWER_BACK
  UPPER_BACK
  SHOULDERS
  CHEST
  SPINE
  FULL_BODY
  NECK
  CALVES
  FOREARMS
  /// Inner thigh — Warrior II and the wide folds load these.
  ADDUCTORS
  /// The joint itself: deep-squat dorsiflexion and calf-raise balance.
  ANKLES
  /// Upper arms — the pressing half of Chaturanga.
  ARMS
}

/// What an exercise *is*, separate from what it corrects. `goal` names the
/// job (GLUTE_STRENGTH, HIP_MOBILITY…); `type` names the shape the body is
/// doing: holding against load, lengthening, or moving continuously. Day
/// composition is built on type — a day that draws three mobility moves is a
/// rest day wearing a workout's clothes.
enum ExerciseType {
  /// Isometric or loaded work — the category every training day is built on.
  STRENGTH
  /// Lengthening and release — the recovery half of the cycle.
  MOBILITY
  /// Sustained continuous movement (Sun Salutations). A day of this is cardio.
  FLOW
}

/// How hard an exercise is to do well, on a three-point scale. Set per
/// exercise in the catalog; the routine generator reads it when the person
/// asked for a gentle week.
enum ExerciseDifficulty {
  /// Gentle enough for a first week or a sore day.
  EASY
  /// The default effort — honest work, nothing exotic.
  MODERATE
  /// Genuinely demanding: strength, balance or position a desk body has to
  /// earn back first.
  HARD
}

/// The intensity the person asked the builder for. EASY filters the pool to
/// easy exercises (relaxing toward moderate only when an easy pool runs
/// out); CHALLENGING draws from the whole catalog.
enum RoutineDifficulty {
  EASY
  CHALLENGING
}

/// What kind of day a routine's slots belong to. The person can name each
/// day's kind in the builder, or let the generator auto-assign the pattern:
/// most days STANDARD (2 strength + 1 mobility), one FLOW day, one RECOVERY
/// day.
enum RoutineDayType {
  /// The workday: strength slots lead, mobility closes.
  STANDARD
  /// One continuous FLOW exercise — the aerobic day.
  FLOW
  /// All mobility — the recovery day the week is periodized around.
  RECOVERY
}

/// The five daily prayers, in order. `MAGHRIB` keeps its Islamic spelling.
enum PrayerKind {
  FAJR
  ZUHR
  ASR
  MAGHRIB
  ISHA
}

// ---------------------------------------------------------------- identity

model User {
  id       String  @id @default(cuid())
  clerkId  String  @unique // subject from `await auth()`
  email    String?
  name     String?
  imageUrl String?

  /// IANA zone. Every calendar day in this schema is bucketed in this zone,
  /// server-side, once. Changing it does not rewrite history.
  timezone  String @default("UTC")
  /// 0 = Sunday .. 6 = Saturday
  weekStart Int    @default(1)

  tags Tag[]

  // Timer defaults. Inlined rather than a 1-1 Settings model because they are
  // always read together with the user.
  pomodoroSeconds     Int     @default(1500)
  shortBreakSeconds   Int     @default(300)
  longBreakSeconds    Int     @default(900)
  longBreakEvery      Int     @default(4)
  autoStartBreaks     Boolean @default(false)
  autoStartNextFocus  Boolean @default(false)
  soundEnabled        Boolean @default(true)
  // Separate from sound on purpose: the pulses at 50% and 10% are there for a
  // phone face-down on the desk, which is exactly when someone has the chime
  // turned off.
  hapticsEnabled      Boolean @default(true)
  /// Browser notifications when a break has run over.
  ///
  /// A third switch rather than a mode of `soundEnabled`, because it answers a
  /// different question. Sound and haptics reach you in the room; this is the
  /// only one that reaches you in another app, which is where the break that
  /// runs away is actually spent. Turning the chime off should not turn that
  /// off too.
  returnAlertsEnabled Boolean @default(true)

  // Water. The goal is glasses per day, and the defaults follow the classic
  // 8×8: 8 glasses × 250ml, one every two hours across a waking window. The
  // science (NASEM) is a range, not a number — 8 is the baseline, the
  // settings let it move to where the person actually is.
  waterGoal                Int     @default(8)
  waterRemindersEnabled    Boolean @default(false)
  /// Minutes from local midnight when the reminder window opens. 480 = 08:00.
  waterReminderStartMin    Int     @default(480)
  /// 1320 = 22:00. Past this the day is a closed session: no more reminders.
  waterReminderEndMin      Int     @default(1320)
  /// Minimum gap between reminders, minutes. Defaults to 120 (one glass per
  /// two hours fills the day's quota inside the window).
  waterReminderIntervalMin Int     @default(120)

  // Prayer reminders. Timings are fetched from the Aladhan API once per
  // (city, date) and cached in PrayerDayTimes; `prayerCity` defaults to
  // "Karachi" in code when null.
  prayerRemindersEnabled Boolean @default(false)
  prayerCity             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects        Project[]
  tasks           Task[]
  occurrences     TaskOccurrence[]
  sessions        FocusSession[]
  captures        Capture[]
  waterLog        WaterGlass[]
  dayLogs         DayLog[]
  journal         JournalEntry[]
  steps           TaskStep[]
  blocks          TimeBlock[]
  moneyCategories MoneyCategory[]
  transactions    MoneyTransaction[]
  moneyBudgets    MoneyBudget[]
  moneyAccounts   MoneyAccount[]
  transfers       AccountTransfer[]
  moneyDebts      MoneyDebt[]
  exerciseRoutines ExerciseRoutine[]
  prayerChecks    PrayerCheck[]
}

// ---------------------------------------------------------------- lists

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  /// Palette token name, resolved to a CSS variable in the UI.
  color      String    @default("teal")
  /// Fractional indexing, so a drag-reorder writes one row.
  sortOrder  Float     @default(0)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@unique([userId, name])
  @@index([userId, archivedAt, sortOrder])
}

// ---------------------------------------------------------------- tasks

/// One model for both todos and habits. Title, notes, project, priority,
/// estimate and the entire timer/logging surface are identical between them,
/// so a single model keeps FocusSession.taskId non-polymorphic. Habit-only
/// fields live in the 1-1 HabitRecurrence side table.
model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type      TaskType
  title     String
  notes     String?
  priority  Priority @default(P4)
  sortOrder Float    @default(0)

  /// Calendar identity: which of the 20 calendar hues a task (and the blocks
  /// it becomes) wears. Defaults to the primary teal, so an uncoloured task
  /// is indistinguishable from the calendar's work colour. Validated against
  /// the same palette list as the picker.
  color String @default("teal")

  /// TODO only. A local calendar date, stored as UTC-midnight DATE.
  dueDate DateTime? @db.Date

  /// "I want to spend 20 minutes on this" -> 1200. Prefills the timer.
  estimatedSeconds Int?
  /// Which timer mode this task opens with.
  defaultMode      TimerMode @default(POMODORO)
  /// Preferred pomodoro split. null => derived from the estimate.
  plannedIntervals Int?

  /// TODO only: terminal completion. Habits are never "completed", only archived.
  completedAt DateTime?
  archivedAt  DateTime?

  /// Habits only: the day isn't DONE until a written note lands on the
  /// occurrence. Off by default — most habits just need doing.
  requiresFeedback Boolean @default(false)
  /// Habits only: the question asked when closing the day, e.g. "What did you
  /// learn?" or "What are you grateful for?". Empty falls back to a default.
  feedbackPrompt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurrence  HabitRecurrence?
  occurrences TaskOccurrence[]
  sessions    FocusSession[]
  steps       TaskStep[]

  // Named relations: Task now has several nullable FKs pointing at it from
  // different models, so Prisma can't disambiguate them positionally.
  promotedFrom     Capture[]   @relation("CapturePromotion")
  dayLogSelections DayLog[]    @relation("DayLogSelection")
  blocks           TimeBlock[] @relation("TaskBlocks")

  /// The one thing that precedes this habit. `cuedBy` is the other direction:
  /// the habits stacked on top of this one.
  cue    HabitCue?  @relation("HabitCueOwner")
  cuedBy HabitCue[] @relation("HabitCueAnchor")

  @@index([userId, type, completedAt, archivedAt, dueDate])
  @@index([userId, projectId, sortOrder])
}

/// One line of "and then what". Ordered, tickable, optional.
///
/// The step at `position: 0` is treated specially by every surface that renders
/// these: it is the one the UI asks you to make embarrassingly small, and the
/// one it puts in front of you instead of the task title when you're deciding
/// whether to start. Starting is the expensive part; the rest of the list is
/// only there so the first line doesn't have to carry the whole task.
model TaskStep {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title    String
  /// 0-based, dense. Deliberately NOT `@@unique([taskId, position])`: a
  /// reorder would then need a two-phase write to dodge the constraint, and
  /// the editor rewrites the whole list in one transaction anyway.
  position Int

  /// Steps carry their own estimate so "make the first one tiny" is a number
  /// you can actually see, not just an instruction.
  estimatedSeconds Int?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
  @@index([userId, completedAt])
}

/// 1-1 with a Task of type HABIT. Absent for todos.
model HabitRecurrence {
  taskId String @id
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  kind       RecurrenceKind @default(DAILY)
  /// 0 = Sunday .. 6 = Saturday, evaluated in User.timezone. DAILY => [0..6].
  daysOfWeek Int[]

  /// The atomic-habit quotas.
  ///
  /// `minimumQuota` is the whole mechanism: it is the amount that counts as
  /// having done the habit, and the only thing the streak cares about. It is
  /// meant to be embarrassingly small — one page, two minutes — because a
  /// streak you can keep on your worst day is the one that survives.
  ///
  /// `optimalQuota` is what you'd do on a good day. It is deliberately NOT
  /// what the streak measures; making the good day the bar is how streaks
  /// break. Null means you never set one.
  unit         HabitUnit @default(MINUTES)
  minimumQuota Int       @default(1)
  optimalQuota Int?
  /// The habit is inert outside this window. startDate also anchors streaks.
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date

  /// The implementation intention: "I will do this at 07:00". Minutes from
  /// midnight in User.timezone. Null means no time plan yet — the habit
  /// sorts after anchored ones and is never the time-aware "Start here" pick.
  timeAnchor   Int?

  /// Which parts of the day this habit belongs to. [ALWAYS] by default so
  /// existing habits stay visible everywhere; a habit shows on /day and the
  /// calendar's scheduling panel only inside a selected window.
  slots        HabitSlot[] @default([ALWAYS])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 1-1 with a Task of type HABIT: the one thing that immediately precedes it.
///
/// Habit stacking works by bolting a new behaviour onto a cue that already
/// happens reliably — "after I pour my morning tea, I will meditate". The cue
/// has to be specific and immediately before, which is why this is one anchor
/// and not a list of vague contexts.
///
/// Exactly one of `anchorTaskId` / `anchorLabel` is set:
///
/// - `anchorTaskId` — the anchor is itself a tracked habit. "Web dev after
///   workout". Both sides have their own quotas and streaks.
/// - `anchorLabel`  — the anchor is a cue you already do without thinking and
///   deliberately do NOT track. Drinking tea gets no quota, no streak and no
///   occurrences, because it was never a goal. It exists only as the label on
///   the front of the habit it triggers.
///
/// One cue per habit, so chains fall out of the model rather than needing their
/// own: tea -> meditation -> journal is three rows, each naming its own
/// predecessor. `HabitCue` is where cycles become possible, so every write goes
/// through `wouldCycle` in `lib/habit-cue.ts`.
model HabitCue {
  taskId String @id
  task   Task   @relation("HabitCueOwner", fields: [taskId], references: [id], onDelete: Cascade)

  /// Cascade rather than SetNull: with both columns null the row would say
  /// nothing at all, so deleting the anchor habit takes the cue with it.
  anchorTaskId String?
  anchorTask   Task?   @relation("HabitCueAnchor", fields: [anchorTaskId], references: [id], onDelete: Cascade)

  anchorLabel String?

  /// How long to reserve for the anchor when the calendar prepends it. For a
  /// habit anchor this is only a fallback — that habit's own estimate wins.
  anchorMinutes Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// "Which habits are stacked on this one" — the chain walk, and the cycle
  /// check's edge map.
  @@index([anchorTaskId])
}

/// SPARSE. One row per (task, local calendar day) that the user actually
/// touched — never pre-generated for future days. Absence means "not done".
///
/// Used for BOTH task types: for a HABIT it is the daily instance; for a TODO
/// it is "the day I worked on this". That uniformity is what lets every stats
/// query read one pair of tables.
model TaskOccurrence {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Local calendar date in User.timezone, stored as UTC-midnight DATE.
  date        DateTime         @db.Date
  status      OccurrenceStatus @default(PENDING)
  completedAt DateTime?
  note        String?

  /// Habits only; stays 0/NONE for todos.
  ///
  /// `progress` is in the habit's own unit. `tier` is derived from it against
  /// the quotas *at the time*, and is what every statistic reads — which is
  /// also why doing the minimum and then carrying on to the optimal counts
  /// once, as OPTIMAL: the tier is a function of the day's total, not a log of
  /// what happened in what order.
  progress Int       @default(0)
  tier     QuotaTier @default(NONE)

  /// Roll-up of this day's FocusSession.elapsedSeconds, maintained by
  /// endSession(). Lets the day list render without an aggregate query.
  loggedSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions FocusSession[]

  @@unique([taskId, date])
  @@index([userId, date, status])
  /// The habit statistics read: one habit across a date range, bucketed by tier.
  @@index([userId, taskId, date])
}

// ---------------------------------------------------------------- time logging

model FocusSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nullable: an untethered timer run with no task attached is allowed.
  taskId       String?
  task         Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  occurrenceId String?
  occurrence   TaskOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  /// Client-generated UUID. Makes startSession idempotent under retries,
  /// double submits and React StrictMode double-effects. A duplicated session
  /// would silently corrupt every aggregate on /stats.
  clientKey String @unique

  mode             TimerMode
  /// The configured goal. POMODORO: intervals * focusSeconds. FLOW: a soft goal.
  targetSeconds    Int
  plannedIntervals Int       @default(1)

  /// Snapshot of the user's settings at start, so changing them later does not
  /// rewrite history.
  focusSeconds      Int
  shortBreakSeconds Int
  longBreakSeconds  Int

  status    SessionStatus @default(RUNNING)
  startedAt DateTime      @default(now())
  endedAt   DateTime?

  /// Authoritative clock state, so a reload can rehydrate a live timer:
  ///   live elapsed = accumulatedSeconds + (now - runningSince)
  /// The server recomputes from these on every write; client-reported elapsed
  /// is only ever a capped cross-check.
  accumulatedSeconds Int       @default(0)
  runningSince       DateTime?
  /// Last heartbeat, used to reap sessions the browser never closed.
  lastBeatAt         DateTime  @default(now())

  /// Final active focus time, excluding pauses and breaks. Written on end.
  elapsedSeconds  Int       @default(0)
  /// FLOW (and any overrun): seconds past targetSeconds. A SUBSET of
  /// elapsedSeconds, so time-spent sums never double count.
  overtimeSeconds Int       @default(0)
  /// The moment the arc hit zero.
  reachedTargetAt DateTime?
  pausedCount     Int       @default(0)

  /// What the clock actually measured, kept the first time someone corrects
  /// the log by hand. Null means nobody has.
  ///
  /// The correction overwrites `elapsedSeconds` rather than living beside it,
  /// because every aggregate in the app reads that column and a log you have to
  /// remember to reconcile is one that will disagree with itself. This keeps
  /// the original anyway: a timer left running overnight is the single most
  /// common way an estimate gets learned, and throwing the measurement away
  /// would also throw away the evidence that the number is a claim, not a
  /// measurement.
  measuredSeconds Int?
  adjustedAt      DateTime?

  /// Did the user tick the task done from the timer screen?
  completedTask Boolean           @default(false)
  endReason     SessionEndReason?

  /// Local calendar date in User.timezone. Denormalized because Prisma groupBy
  /// cannot bucket a timestamp by day — this one column is what makes the whole
  /// stats view groupBy/aggregate instead of $queryRaw.
  localDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intervals SessionInterval[]

  @@index([userId, localDate])
  @@index([userId, status, lastBeatAt])
  @@index([taskId, startedAt])
  @@index([occurrenceId])
}

/// One row per focus/break segment, created lazily as each begins.
model SessionInterval {
  id        String       @id @default(cuid())
  sessionId String
  session   FocusSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// 0-based order within the session.
  index         Int
  kind          IntervalKind @default(FOCUS)
  targetSeconds Int

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  accumulatedSeconds Int       @default(0)
  runningSince       DateTime?

  elapsedSeconds  Int     @default(0)
  /// Time past `targetSeconds`. On a break this is the overrun — the five
  /// minutes that became forty — which is only measurable because the break
  /// now stays on the clock instead of pausing at its own boundary.
  ///
  /// Time taken deliberately does NOT land here: "5 more minutes" raises
  /// `targetSeconds` instead, so a break you extended and a break that got away
  /// from you stay distinguishable. They look identical on a clock and mean
  /// opposite things.
  overtimeSeconds Int     @default(0)
  /// Reached its target, as opposed to being skipped.
  completed       Boolean @default(false)

  /// What you were in the middle of when the break started.
  ///
  /// The expensive half of a switch is coming back, not going away: by the time
  /// the break ends the thread is gone, and re-deriving it is what the next
  /// twenty minutes get spent on. Written while you still know the answer, and
  /// handed back at the boundary and in the notification.
  ///
  /// On the interval rather than the session because a later break is a
  /// different return to a different place.
  returnNote String?

  @@unique([sessionId, index])
  @@index([sessionId])
}

// ---------------------------------------------------------------- capture

/// A thought, verbatim, at the moment it occurred.
///
/// Zero fields beyond the text — because every field is a decision, and a
/// decision is a reason not to capture at all. Triage happens later and
/// somewhere else (/inbox), deliberately.
model Capture {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body   String
  status CaptureStatus @default(RAW)

  /// What was behind the moment, picked from the tag set. SetNull on delete:
  /// removing a custom tag keeps the record — it just loses its label.
  tagId String?
  tag   Tag?   @relation(fields: [tagId], references: [id], onDelete: SetNull)

  /// Set when triage turns this into a task. SetNull rather than Cascade: the
  /// record that the thought existed should outlive the task it became.
  promotedTaskId String?
  promotedTask   Task?   @relation("CapturePromotion", fields: [promotedTaskId], references: [id], onDelete: SetNull)

  /// Local calendar date in User.timezone — the same pre-bucketing as
  /// FocusSession.localDate, so "what do I dump, and when" stays a groupBy.
  localDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No @@unique anywhere, deliberately. Two identical dumps are two separate
  // thoughts, and a constraint violation is the one failure mode that would
  // make capture cost something.
  @@index([userId, status, createdAt])
  @@index([userId, localDate])
}

// ---------------------------------------------------------------- behavior tags

/// The reason a behavior was logged.
///
/// System tags have `userId = null` and belong to everyone — they ship with the
/// product and cannot be deleted. Custom tags belong to one user and can be.
/// A row keeps its tag as long as the tag exists; deleting a custom tag keeps
/// the entries, just untagged (SetNull on Capture.tagId).
model Tag {
  id   String @id @default(cuid())
  user User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null means shared/system — the built-in set, created by the seed script.
  userId String?
  name  String
  /// The tooltip text: what this state actually feels like, so a logged urge
  /// is classified against a definition, not a memory.
  description String?
  /// True for the built-ins, which a user can never edit or delete.
  system Boolean @default(false)

  captures Capture[]

  @@unique([userId, name])
  @@index([userId])
}

// ---------------------------------------------------------------- hydration

/// One row per glass of water actually logged — SPARSE, exactly like
/// TaskOccurrence. Absence means "not drunk", the count for a day is a
/// groupBy rather than a stored total, and nothing is ever pre-generated.
///
/// `timeMinute` is what makes the two most useful messages a query instead of
/// a guess: "last glass was 3h ago" (the reminder) and "you're behind the
/// pace line" (the vessel marker). A backdated glass keeps its claimed time —
/// this is a log of when things happened, not a stream of button presses.
model WaterGlass {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Local calendar day in User.timezone, stored as UTC-midnight DATE — the
  /// same pre-bucketing every other day in this schema uses.
  date DateTime @db.Date

  /// Minutes from local midnight, clamped to "now" on write.
  timeMinute Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No @@unique anywhere, deliberately: two glasses at the same minute are
  // two glasses, and a constraint violation is the one failure mode that
  // would make logging cost something.
  @@index([userId, date])
}

// ---------------------------------------------------------------- prayer

/// One row per prayer actually checked — SPARSE, exactly like WaterGlass and
/// TaskOccurrence. Absence means "not prayed". The daily cron wipes every row
/// older than the current day at 04:00 Asia/Karachi, so a cycle lives roughly
/// fajr-to-fajr and there is no history.
model PrayerCheck {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The local day the prayer *belongs* to (the day of its own start time —
  /// Isha of day D is checkable until Fajr(D+1) − 30, past midnight).
  date   DateTime  @db.Date
  prayer PrayerKind

  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date, prayer])
  @@index([userId, date])
}

/// Cache of Aladhan API timings, one row per (city, date). Fetched lazily on a
/// miss so the API is called at most once per city per day, shared by the day
/// page and the calendar; pruned by the same daily cron that wipes checks.
model PrayerDayTimes {
  id        String   @id @default(cuid())
  city      String
  /// The local day the timings belong to, UTC-midnight DATE.
  date      DateTime @db.Date
  /// { fajr, sunrise, dhuhr, asr, maghrib, isha } — minutes from local
  /// midnight. Stored as Json rather than six columns because it is one
  /// opaque API payload consumed whole.
  timings   Json
  fetchedAt DateTime @default(now())

  @@unique([city, date])
}

// ---------------------------------------------------------------- the day

/// One row per user per local day — the shared anchor between the morning
/// (what is today's one thing) and the evening (how the day was closed).
///
/// Created lazily, like TaskOccurrence: a day nobody opened has no row, and
/// absence means "nothing chosen", not "chose nothing".
model DayLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  /// The one thing. Always a real Task, even when typed fresh in the morning
  /// pass — that is what makes it clickable straight into the timer.
  selectedTaskId String?
  selectedTask   Task?     @relation("DayLogSelection", fields: [selectedTaskId], references: [id], onDelete: SetNull)
  selectedAt     DateTime?

  /// Stamped by the last step of /close. Its presence is what "today is
  /// finished" means.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// "One day, one thing" is the feature. It also makes every write a single
  /// upsert with no read-modify-write race.
  @@unique([userId, date])
}

// ---------------------------------------------------------------- calendar

/// A claim on a piece of the day.
///
/// Stored as (local date + minute offsets) rather than two timestamps, for the
/// same reason every other day in this schema is a `@db.Date`: the day is
/// resolved once, in `User.timezone`, and never re-bucketed. It also makes
/// every overlap, gap and "does this fit" question integer arithmetic on
/// minutes, which is testable without a clock — see lib/time-blocks.ts.
///
/// A block is a plan, and a FocusSession is what happened. They are separate on
/// purpose: reconciling them is the whole value ("you blocked 3h and spent 40
/// minutes"), and that comparison is impossible if planning writes to the log.
model TimeBlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nullable: blocking "lunch" or "gym" is a legitimate use, and a block with
  /// no task is not a broken block. SetNull rather than Cascade — deleting a
  /// task shouldn't silently punch a hole in a day you already planned.
  taskId String?
  task   Task?   @relation("TaskBlocks", fields: [taskId], references: [id], onDelete: SetNull)

  /// Snapshotted from the task at create time, so renaming or deleting the task
  /// leaves the calendar readable.
  title String
  notes String?

  /// Local calendar date in User.timezone, as a UTC-midnight DATE.
  date        DateTime @db.Date
  /// Minutes from local midnight. start is inclusive, end exclusive, so
  /// adjacent blocks touching at 10:00 do not read as overlapping.
  /// 0..1440 — 1440 is a legal end (midnight) but never a legal start.
  startMinute Int
  endMinute   Int

  kind BlockKind @default(WORK)

  /// Ticked off from the calendar. Distinct from Task.completedAt: finishing
  /// the 9am block on a task is not finishing the task.
  completedAt DateTime?

  /// Set when this block was auto-prepended as another block's precursor — the
  /// calendar half of `HabitCue`. Keeping the pair joined is what lets dragging
  /// the habit carry its cue along, and lets "not today" drop just the cue
  /// without touching the habit's definition.
  ///
  /// `@unique` because a block has at most one precursor. Cascade so deleting
  /// the habit's block takes its cue with it, but never the reverse.
  cueForId String?    @unique
  cueFor   TimeBlock? @relation("BlockCue", fields: [cueForId], references: [id], onDelete: Cascade)
  cue      TimeBlock? @relation("BlockCue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves both "one day's blocks in order" and the week fetch (a date range
  /// scan), which are the only two reads.
  @@index([userId, date, startMinute])
  @@index([taskId, date])
}

/// Journal, not inbox.
///
/// A worry written down at 22:00 is not a task and must never be offered as
/// one. Separate model rather than a Capture variant, because a shared table
/// would eventually leak into triage, search or promotion by way of one
/// forgotten `where` clause.
model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime    @db.Date
  kind JournalKind
  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lets each close step be a blind upsert — this constraint is exactly what
  /// makes "walk back a step and edit it" overwrite rather than append.
  /// Caps you at one worry and one gratitude per day; to allow a running log,
  /// drop this and switch the actions from upsert to create.
  @@unique([userId, date, kind])
  @@index([userId, date])
}

// ---------------------------------------------------------------- money

/// A place money lives: the wallets, banks and cards the ledger is kept in.
///
/// Every money movement sits inside exactly one account (except a transfer,
/// which moves between two). Accounts are archived, never deleted while they
/// hold history — the same rule as categories — with `openingCents` ("money
/// already here before I started logging") so a balance can match reality
/// from day one.
model MoneyAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  /// Palette token, resolved to a CSS variable in the UI — the same four as
  /// categories, so an account's dot reads against them.
  color String @default("teal")
  /// Integer minor units (paise). Money already in the account when you
  /// started tracking, added to the running balance like an income.
  openingCents Int @default(0)

  sortOrder  Float     @default(0)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions MoneyTransaction[]
  transfersOut AccountTransfer[] @relation("TransferOut")
  transfersIn  AccountTransfer[] @relation("TransferIn")

  @@unique([userId, name])
  @@index([userId, archivedAt, sortOrder])
}

/// A transfer between two of the user's own accounts.
///
/// Deliberately NOT a MoneyTransaction: money moved between your own accounts
/// is neither income nor expense, and must never show up in the month's
/// in-vs-out, the donut, the jar or the headline. It only moves the balances
/// of the two accounts it joins. `from` is exclusive of `to` (a transfer to
/// yourself is logged as nothing).
model AccountTransfer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromAccountId String
  fromAccount   MoneyAccount @relation("TransferOut", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     MoneyAccount @relation("TransferIn", fields: [toAccountId], references: [id], onDelete: Restrict)

  /// Integer minor units (paise), like every other amount.
  amountCents Int

  /// Local calendar day in User.timezone, UTC-midnight DATE.
  date DateTime @db.Date
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, fromAccountId, date])
  @@index([userId, toAccountId, date])
}

/// A bucket for money movement, on one side of the ledger.
///
/// `ownerKey` is "global" for the seeded built-ins (Food, Medical, Salary…)
/// and the user's id for their own. A nullable `userId` is the reason for
/// `ownerKey`: Postgres treats NULLs as distinct, so a `@@unique([userId, kind,
/// name])` could never hold the global set together. Postgres's partial
/// indexes are unreachable from Prisma, so the key is a plain string.
///
/// Categories are archived, never deleted while in use — a transaction's
/// category is part of its record, so `onDelete: Restrict` and an
/// `archivedAt`, exactly like Project.
model MoneyCategory {
  id       String  @id @default(cuid())
  ownerKey String
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  MoneyKind
  name  String
  /// Palette token name, resolved to a CSS variable in the UI. The same five
  /// as Project — validation pins the safe subset (clay is reserved for
  /// "something went wrong" and never a category).
  color String    @default("teal")

  sortOrder  Float     @default(0)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions MoneyTransaction[]

  @@unique([ownerKey, kind, name])
  @@index([ownerKey, archivedAt, sortOrder])
}

/// One line of the ledger: money in or money out, on a local calendar day.
///
/// The amount is integer minor units (paise) — never floats, which is how
/// money accumulates rounding errors. The date follows the house rule: a local
/// calendar day in `User.timezone`, stored as a UTC-midnight DATE, resolved
/// once and never re-bucketed.
model MoneyTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The account this money sits in. Every entry — income or expense — lands
  /// in exactly one account. Nullable only so existing entries can be
  /// backfilled into a default account; the app never writes one without an
  /// account. Restrict: an account is archived, never deleted, while it holds
  /// entries.
  accountId String?
  account   MoneyAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  categoryId String
  category   MoneyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The envelope this expense counts against, if any. Removing an expense
  /// from a budget is setting this to null — the transaction itself stays.
  budgetId String?
  budget   MoneyBudget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  /// Integer minor units. PKR has 100 paise per rupee.
  amountCents Int
  /// What it was for, when the category alone doesn't say. Optional.
  note        String?

  /// Local calendar day in User.timezone, UTC-midnight DATE.
  date DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, budgetId])
  @@index([userId, accountId])
}

/// A spending envelope: a target amount over a custom range of days.
///
/// An expense counts against a budget only when it is explicitly assigned
/// (`MoneyTransaction.budgetId`) — the envelope is not a filter on the ledger,
/// it is what you put in it. Ranges are deliberately custom (10–20 Aug),
/// escaping the month grain: a budget is the shape of a real need, not a
/// calendar page. An expense may only be assigned when its own date falls
/// between `startsOn` and `endsOn`.
model MoneyBudget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  /// Integer minor units (paise), like every other amount.
  amountCents Int

  /// Local calendar days in User.timezone, UTC-midnight DATEs.
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactions MoneyTransaction[]

  @@index([userId, archivedAt, startsOn])
}

/// An IOU: money promised between you and someone else, before it moves.
///
/// Deliberately NOT a MoneyTransaction — money you owe hasn't left your
/// account and money owed to you hasn't arrived, so it must never show up in
/// the month's in-vs-out, the donut, the jar or the headline. It is a claim,
/// kept on its own ledger, and the two directions are different lists: the
/// teal pocket (people who owe you) and the clay pocket (people you owe).
///
/// Crossing an IOU off is setting `settledAt` — the row stays, struck
/// through, because "who owed you money in March" is history, not noise. The
/// row is only ever hard-deleted when it should never have existed.
model MoneyDebt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The person on the other side of the money. A name, not an entity —
  /// "Ali", "the landlord", "Mum".
  counterparty String
  direction    DebtDirection
  /// What it was for, when the name alone doesn't say. Optional.
  note         String?
  /// Integer minor units (paise), like every other amount.
  amountCents Int
  /// When it happened. Local calendar day in User.timezone, UTC-midnight DATE.
  date DateTime @db.Date
  /// Set when the IOU is crossed off. The row stays, muted, for history.
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The two pockets are reads, so the index covers them: one side of the
  /// ledger, outstanding first, oldest first within it.
  @@index([userId, direction, settledAt, date])
}

// ---------------------------------------------------------------- exercises

/// One exercise in the global catalog. Content, not user data: the same
/// catalog serves every person, so it carries no userId (the same pattern as
/// the seeded built-in money categories). `active` hides an exercise instead
/// of deleting it, so routines that already reference it never orphan.
///
/// `prescription` is a single human-readable line ("3 × 12–15 each side",
/// "Hold 60–90s per side") rather than structured numbers, because the dose
/// that matters for corrective work is written the way a coach says it, not
/// the way a machine counts it. The generator only needs the tags.
model Exercise {
  id       String @id @default(cuid())
  name     String
  /// Yoga: mat only. DUMBBELL: a pair of light dumbbells.
  equipment ExerciseEquipment
  /// The primary corrective job. The generator composes days from this.
  goal    ExerciseGoal
  /// STRENGTH / MOBILITY / FLOW — the shape the body is doing. Day
  /// composition draws on this, so a workout day can never be all stretches.
  type    ExerciseType
  /// How hard it is to do this well. Drives the gentle-week pool filter.
  difficulty ExerciseDifficulty @default(MODERATE)
  /// Muscle groups worked, for catalog filters. `goal` is the intent, this is
  /// the territory.
  bodyParts BodyPart[]
  /// Step-by-step lines, in order, as a coach would say them.
  instructions String[]
  /// "3 × 12–15 each side" / "Hold 60s per side" / "10 breaths each side".
  prescription String
  /// YouTube embed, supplied later. The detail dialog renders it when set.
  videoUrl String?

  sortOrder Float   @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routineSlots RoutineExercise[]

  @@unique([name])
  @@index([equipment, goal])
  @@index([equipment, active, sortOrder])
}

/// A person's weekly routine: which days they train, and the exercises that
/// make up each of those days. A static weekly template — no dates, no
/// history — because a routine is a plan you repeat, not an event log.
///
/// `daysOfWeek` follows the house convention: 0 = Sunday .. 6 = Saturday.
model ExerciseRoutine {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Auto-named at creation; editable later if we add an edit surface.
  name String

  /// Which catalog the generator draws from: yoga only, dumbbells only, or
  /// the mix. Set at build time; regeneration keeps drawing from this pool.
  /// A manual swap may still reach outside it — a deliberate override.
  equipment RoutineEquipment @default(MIX)

  /// The intensity chosen at build time: EASY keeps the week to easy
  /// exercises, CHALLENGING uses the whole catalog. Regeneration keeps
  /// drawing at this level. Existing routines read as CHALLENGING — the
  /// migration backfills it that way on purpose.
  difficulty RoutineDifficulty @default(CHALLENGING)

  /// 0 = Sunday .. 6 = Saturday. Length 3, 4, 5 or 6 — the whole point of the
  /// builder is that the person picks the exact days.
  daysOfWeek Int[]

  /// What each day is *for*, index-aligned with `daysOfWeek`: STANDARD
  /// (strength + mobility), FLOW (the aerobic day) or RECOVERY (all
  /// mobility). Chosen in the builder, or auto-assigned by the generator.
  dayTypes RoutineDayType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises RoutineExercise[]

  @@index([userId])
}

/// One exercise on one day of a routine. `position` 0..4 IS the "never more
/// than five exercises a day" rule — the constraint is in the schema, not
/// the UI. Days may carry different counts (1..5), so a day's slots are
/// simply whatever rows exist for it.
///
/// `swapped` pins a slot: the person replaced what the generator proposed,
/// and a "Regenerate" reshuffle must leave their pick alone.
model RoutineExercise {
  id         String          @id @default(cuid())
  routineId  String
  routine    ExerciseRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  /// 0 = Sunday .. 6 = Saturday.
  dayOfWeek Int
  /// 0..4 — the day's slot. The 5/day cap lives here.
  position  Int
  /// True when the person swapped this slot manually; regeneration keeps it.
  swapped   Boolean @default(false)

  @@unique([routineId, dayOfWeek, position])
  @@index([routineId, dayOfWeek])
  @@index([exerciseId])
}
