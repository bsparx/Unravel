# Copy to .env and fill in real values.

# --- Neon Postgres -----------------------------------------------------------
# Use the POOLED connection string from the Neon dashboard (the host containing
# "-pooler"). Prisma 7 reads this via prisma.config.ts, not from schema.prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Clerk -------------------------------------------------------------------
# From https://dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/today"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/today"

# --- Cron --------------------------------------------------------------------
# Protects /api/cron/reset-steps (the daily habit-step reset). Set this in the
# Vercel project too: when CRON_SECRET exists there, Vercel automatically
# sends it as `Authorization: Bearer $CRON_SECRET` on cron requests.
# Generate one with: openssl rand -base64 32
CRON_SECRET=""
